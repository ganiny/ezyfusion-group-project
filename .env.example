# Copy to .env.local. All values are the LOCAL Supabase stack's well-known
# defaults; if yours differ, take them from `npx supabase status`.

# API_URL from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY from `npx supabase status` (safe for the browser).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# SECRET_KEY from `npx supabase status`. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# DB_URL from `npx supabase status` (direct Postgres, port 54322). Used by Prisma at runtime.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Same direct connection; locally there is no pooler, so it equals DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Shared HMAC key for the payment gateway webhook (the brief's test key).
GATEWAY_X_SIGNATURE_KEY=test_x_signature_key
