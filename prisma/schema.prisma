// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma 7: the connection URL lives in prisma7.config.ts (CLI) and in the
// driver adapter in lib/prisma.ts (runtime), not in this datasource block.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
